{
  "name": "scoutling",
  "version": "0.0.1",
  "description": "🐦 Your little birds for the codebase — a read-only, bounded investigator that any coding agent can send ahead, on any local OpenAI-compatible model.",
  "license": "MIT",
  "author": "Petr Plavjanik",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plavjanik/scoutling.git"
  },
  "homepage": "https://github.com/plavjanik/scoutling#readme",
  "bugs": "https://github.com/plavjanik/scoutling/issues",
  "keywords": [
    "cli",
    "agent",
    "subagent",
    "claude-code",
    "codex",
    "opencode",
    "cursor",
    "llm",
    "local-llm",
    "lm-studio",
    "ollama",
    "openai-compatible",
    "read-only",
    "codebase",
    "investigation",
    "toon"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2",
  "bin": {
    "scoutling": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx script/smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.39",
    "@toon-format/toon": "^4.1.0",
    "@vscode/ripgrep": "^1.18.0",
    "ai": "^7.0.83",
    "ignore": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
